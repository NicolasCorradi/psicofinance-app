# Archivo de ejemplo: copiá esto a .env y completá con tus valores reales
# NUNCA subir el .env real a git

# Conexión a Supabase PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# Clave de API de Supabase (para operaciones de administración)
SUPABASE_KEY=tu_supabase_key_aqui

# URL del proyecto Supabase (sin /rest/v1)
SUPABASE_URL=https://tu-proyecto.supabase.co

# JWT Secret de Supabase (Settings → API → JWT Secret)
# Con esto la API valida los tokens de sesión del frontend.
# Vacío = API sin autenticación (SOLO desarrollo local)
SUPABASE_JWT_SECRET=

# Service role key — SOLO para scripts de seed, nunca en la app
SUPABASE_SERVICE_ROLE_KEY=

# Clave secreta para JWT (autenticación futura)
SECRET_KEY=una_clave_secreta_muy_larga_y_segura

# Tasa de inflación mensual estimada (ej: 0.05 = 5% mensual)
# El PM actualiza este valor cada mes según el contexto macroeconómico
INFLACION_MENSUAL=0.05

# Configuración del Semáforo Monotributo
# Categoría actual del psicólogo (letra según AFIP)
MONOTRIBUTO_CATEGORIA=D
# Tope de facturación anual para esa categoría (en pesos, sin puntos ni comas)
MONOTRIBUTO_TOPE_ANUAL=16450000
# Umbral para alerta amarilla (0.80 = 80% del tope)
MONOTRIBUTO_UMBRAL_AMARILLO=0.80
# Criterio del facturado 12m: DEVENGADO (por fecha de sesión, criterio ARCA)
# o PERCIBIDO (por fecha de cobro). Confirmar con el contador.
MONOTRIBUTO_CRITERIO=DEVENGADO

# Tipo de cambio de emergencia si falla la API del dólar (actualizar cada tanto)
DOLAR_FALLBACK=1000

# === COPILOTO NLP (Sprint 2) ===
# Obtener en: aistudio.google.com → "Get API Key"
GEMINI_API_KEY=tu_gemini_api_key_aqui
# Modelo a usar (cambiar si Google lanza una versión más nueva)
GEMINI_MODEL=gemini-2.5-flash-preview-05-20
